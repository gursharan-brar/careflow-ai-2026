# Copy this file to .env and fill in real values. Never commit .env.

# Flask session signing key. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-64-char-hex-string

# Anthropic API key used for triage classification, the health feed, both chatbots, and weekly analytics.
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Set to "development" to relax the secure-cookie flag for local dev over plain HTTP.
# Werkzeug's interactive debugger is hard-disabled in app.py regardless of this value.
FLASK_ENV=development

# Path to the SQLite database file.
DATABASE_PATH=careflow.db

# How long a staff session cookie stays valid (seconds), enforced server-side
# against the signed cookie's embedded timestamp on every request regardless of
# how the browser handles it (see app.py). Without this, Flask defaults to 31 days.
SESSION_LIFETIME_SECONDS=28800

# Comma-separated list of origins allowed to call the API with credentials (the dashboard origin(s)).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Gmail SMTP account used to send check-in confirmation and queue-position emails.
MAIL_USERNAME=your-gmail-address@gmail.com
# Gmail App Password (16 chars, spaces are stripped automatically) - not your regular Gmail password.
MAIL_PASSWORD=your-16-char-gmail-app-password
MAIL_DEFAULT_SENDER=your-gmail-address@gmail.com

# Port the Flask backend listens on.
PORT=5000

# URL of the staff dashboard, used by the login page to redirect after a successful login.
DASHBOARD_URL=http://localhost:3000
